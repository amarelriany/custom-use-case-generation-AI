# Required: Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Backup Gemini API key used automatically if the primary key fails
GEMINI_BACKUP_API_KEY=

# Optional: Firecrawl API key for multi-page website mapping & markdown scraping
# If omitted, the agent automatically falls back to direct HTTP scraping + DuckDuckGo snippets
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Optional: Override default Gemini model or system prompt file
GEMINI_MODEL=models/gemini-3.7-flash
SYSTEM_PROMPT_FILE=system_prompt.txt
